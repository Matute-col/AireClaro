# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.
PORT=3000
NODE_ENV=development

# Base de datos (secreto). Cadena de conexión del proveedor de PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true

# Base SOLO para `npm test` (secreto): otra base u otra rama, nunca la principal.
# Las pruebas borran sus datos y se detienen si apunta al mismo servidor que DATABASE_URL.
TEST_DATABASE_URL=

# Autenticación (secreto). Cadena larga y aleatoria.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Archivos subidos
UPLOAD_DIR=./uploads
MAX_PHOTO_MB=8
MAX_VIDEO_MB=25

# Geocodificación inversa (OpenStreetMap Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AireClaro-UNAD/1.0 (contacto: <tu-correo>)

CORS_ORIGIN=*

# Registrar el mensaje completo de los errores 500 (puede contener datos personales).
# Déjalo en false; actívalo solo un momento para depurar.
LOG_ERROR_DETAILS=false

# Correo: test (todo va a MAIL_TEST_TO) | live (a la autoridad) | off
MAIL_MODE=test
MAIL_TEST_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
