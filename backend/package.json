{
  "name": "aireclaro-backend",
  "version": "1.0.0",
  "description": "AireClaro REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "migrate": "node-pg-migrate up -m src/db/migrations --envPath .env",
    "migrate:down": "node-pg-migrate down -m src/db/migrations --envPath .env",
    "migrate:create": "node-pg-migrate create -m src/db/migrations -j sql",
    "migrate:test": "node-pg-migrate up -m src/db/migrations --envPath .env -d TEST_DATABASE_URL"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pdf-parse": "^2.4.5",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
